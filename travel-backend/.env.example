# Backend environment variables
# Database
DB_NAME=travel_db
DB_USER=travel_user
DB_PASSWORD=travel_password
DB_HOST=127.0.0.1
DB_PORT=5432

# Django settings
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SECRET_KEY=your-django-secret-key-here

# Email Settings (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=TravelBaMia <your-email@gmail.com>

# Chatbot AI Settings (Ollama)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Payment Webhook Signature (chống giả mạo IPN)
PAYMENT_WEBHOOK_SECRET=mock_signature_12345

# CORS (False để giới hạn origin trong production)
CORS_ALLOW_ALL_ORIGINS=True
